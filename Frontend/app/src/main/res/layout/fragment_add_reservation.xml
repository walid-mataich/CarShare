<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFF7F2">

    <!-- 🔍 FILTRES -->
    <EditText
        android:id="@+id/edtOrigin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Lieu de départ"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edtDestination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Lieu de destination"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edtDriver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du conducteur"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edtSeats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de places nécessaires"
        android:inputType="number"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edtMaxPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Prix maximum (DH)"
        android:inputType="numberDecimal"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnFilter"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Filtrer"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_rounded_orange"
        android:layout_marginBottom="16dp"/>

    <!-- 📋 LISTE DES TRAJETS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tripsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

</LinearLayout>
